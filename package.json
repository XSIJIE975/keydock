{
  "name": "keydock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-changelog.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "fixtures:build": "esbuild fixtures/react-form/main.tsx --bundle --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=fixtures/react-form/dist/bundle.js",
    "test": "tsc -b",
    "changeset": "changeset",
    "version:packages": "changeset version && node scripts/sync-version.mjs",
    "check-release": "node scripts/check-release.mjs",
    "release:body": "node scripts/release-body.mjs",
    "fill-updater-notes": "node scripts/fill-updater-notes.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "changelog:build": "node scripts/build-changelog.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
